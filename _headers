/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self' 'unsafe-inline' https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com; font-src 'self'; connect-src 'self' https://www.google-analytics.com; media-src 'none'; frame-src 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=2629743

/images/*
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=120

/*/
  Cache-Control: public, max-age=120

/*.css
  Cache-Control: public, max-age=1209600

/*.js
  Cache-Control: public, max-age=1209600
